# Service systemd pour l'agent SIGDEP-3 — template installé par install.sh.
# Les @PLACEHOLDER@ sont remplacés par install.sh selon le dossier choisi.
#
# Le JRE est EMBARQUÉ (@INSTALL_DIR@/jre) : aucun Java requis sur la machine.
# Le .env est lu depuis le dossier d'installation (spring-dotenv le trouve via
# le WorkingDirectory).
[Unit]
Description=SIGDEP-3 Edge Sync Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
Group=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
# JRE embarqué — pas de dépendance Java système.
ExecStart=@INSTALL_DIR@/jre/bin/java -Dfile.encoding=UTF-8 -jar @INSTALL_DIR@/sigdep-sync.jar
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sigdep-sync

# --- Durcissement (protection des données de santé au repos) ---
# Le buffer SQLite et le .env (clé API + mot de passe MySQL) ne doivent pas
# être lisibles par les autres comptes de la machine. UMask=0077 fait que tout
# fichier créé par l'agent (buffer.sqlite, -wal, -shm) est en 600.
UMask=0077
# Empêche l'agent d'acquérir de nouveaux privilèges (setuid, capabilities).
NoNewPrivileges=true
# Système en lecture seule sauf le dossier du buffer, home des autres users
# masqué, /tmp privé. Réduit la surface en cas de compromission de l'agent.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Seul le dossier du buffer reste inscriptible malgré ProtectSystem=strict.
ReadWritePaths=/var/lib/sigdep-sync

[Install]
WantedBy=multi-user.target
